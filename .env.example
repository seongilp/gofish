# data.go.kr 공공데이터포털 서비스키 (서버 전용).
# 발급: https://www.data.go.kr → 마이페이지 → 개발계정 → 일반 인증키
# 반드시 **Encoding** 형태(%2F, %2B, %3D 가 이미 들어 있는 쪽)를 넣어라.
# 재인코딩하면 SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 난다.
#
# 필요한 활용신청:
#   15142486 해양수산부 국립해양조사원_바다낚시지수 조회 서비스
DATA_GO_KR_KEY=

# Discord 웹훅 URL. 웹훅 URL 자체가 인증수단이다 — 아는 사람은 누구나 그 채널에
# 메시지를 보낼 수 있다. 절대 클라이언트에 노출하거나 코드에 적지 말 것.
# NEXT_PUBLIC_ 접두사 금지.
DISCORD_WEBHOOK_URL=

# 크론 라우트 인증. Vercel Cron 이 Authorization: Bearer 로 붙여 준다.
# 없으면 크론 라우트가 503 으로 거부한다 — 실수로 열어두는 쪽보다 낫다.
# 생성: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
CRON_SECRET=

# Discord embed 의 링크용 절대 URL. 상대경로로는 링크가 안 걸린다.
NEXT_PUBLIC_SITE_URL=https://gofish-kr.vercel.app
